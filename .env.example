# Copy this file to .env and fill in your values.
# .env is listed in .gitignore — never commit real credentials.

# ── Schedule ────────────────────────────────────────────────────────────────
# Standard 5-field cron expression (minute hour day month weekday).
# Default: 00:00 daily.  Example for every 5 minutes (testing): */5 * * * *
CRON_EXPRESSION=0 0 * * *

# ── Microsoft Entra ID ───────────────────────────────────────────────────────
# Create an App Registration in Azure Portal and grant it (Application permissions):
#   Microsoft Graph > User.Read.All
#   Microsoft Graph > User.ReadWrite.All
# Then grant admin consent for your tenant.
ENTRA_TENANT_ID=your-tenant-id
ENTRA_CLIENT_ID=your-client-id
ENTRA_CLIENT_SECRET=your-client-secret

# ── Mimecast Awareness Training ──────────────────────────────────────────────
# Mimecast 2.0 API uses OAuth 2.0 client credentials.  Create an API 2.0
# application in the Mimecast Administration Console under
#   Services > API and Platform Integrations
# and copy the generated Client ID and Client Secret below.
#
# Regional base URLs:
#   Global:  https://api.services.mimecast.com
#   US:      https://us-api.mimecast.com
#   EU:      https://eu-api.mimecast.com
#   DE:      https://de-api.mimecast.com
#   CA:      https://ca-api.mimecast.com
#   ZA:      https://za-api.mimecast.com
#   AU:      https://au-api.mimecast.com
MIMECAST_BASE_URL=https://api.services.mimecast.com
MIMECAST_CLIENT_ID=your-client-id
MIMECAST_CLIENT_SECRET=your-client-secret

# ── Tuning ──────────────────────────────────────────────────────────────────
# Records per paginated API call.  50 is a safe default for both APIs.
PAGE_SIZE=50

# Minimum number of unwatched training videos before an account is disabled.
# Default: 4.
DISABLE_THRESHOLD=4

# Set to true to perform a read-only validation run (no accounts modified).
DRY_RUN=false
